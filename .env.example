# Application Settings
APP_NAME="FinRAG Analyst Agent"
ENV="development"
DEBUG=True

# Graph chat roles (openai | groq | anthropic | google | ollama).
# Load this file explicitly: uv run --env-file .env uvicorn app.main:app --reload
# Temperatures reproduce the previous graph's 0.1 / 0.0 / 0.2 choices.
FINRAG_GENERATION__PROVIDER="openai"
FINRAG_GENERATION__MODEL="gpt-4o-mini"
FINRAG_GENERATION__TEMPERATURE=0.1
FINRAG_GRADING__PROVIDER="openai"
FINRAG_GRADING__MODEL="gpt-4o-mini"
FINRAG_GRADING__TEMPERATURE=0.0
FINRAG_QUERY_REWRITE__PROVIDER="openai"
FINRAG_QUERY_REWRITE__MODEL="gpt-4o-mini"
FINRAG_QUERY_REWRITE__TEMPERATURE=0.2

# Maximum query-rewrite model invocations after relevance failure. Zero disables rewriting.
FINRAG_RETRIEVAL__MAX_REWRITE_ATTEMPTS=2
# Reciprocal Rank Fusion constant. Must be a positive integer.
FINRAG_RETRIEVAL__RRF_K=60
# Optional local post-RRF reranking. Enabling may download/load the configured model.
FINRAG_RETRIEVAL__RERANKER_ENABLED=false
FINRAG_RETRIEVAL__RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# Legacy helper/demo settings; these no longer select graph chat models.
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Groq / Ollama Settings
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Embedding Model (text-embedding-3-small | sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Qdrant Vector DB Settings (Local file storage or Cloud)
QDRANT_LOCATION=":memory:"  # Use ":memory:" for fast local dev, or path like "./qdrant_db"
QDRANT_COLLECTION_NAME="financial_reports"

# LangSmith Observability (Crucial for CV)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="finrag-agent-production"

# Legacy web settings; the current graph does not register a web-search node.
WEB_SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""
