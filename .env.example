# Application Settings
APP_NAME="FinRAG Analyst Agent"
ENV="development"
DEBUG=True

# LLM Provider Configuration (openai | groq | ollama)
LLM_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Optional: Groq / Ollama Settings
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Embedding Model (text-embedding-3-small | sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Qdrant Vector DB Settings (Local file storage or Cloud)
QDRANT_LOCATION=":memory:"  # Use ":memory:" for fast local dev, or path like "./qdrant_db"
QDRANT_COLLECTION_NAME="financial_reports"

# LangSmith Observability (Crucial for CV)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="finrag-agent-production"

# Web Search Fallback (tavily | duckduckgo)
WEB_SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""
